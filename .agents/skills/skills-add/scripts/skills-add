#!/bin/bash
# skills-add — 外部スキルをインストールして skills.lock.json に自動登録する
#
# 概要:
#   指定した GitHub リポジトリから bunx skills add でスキルをインストールし、
#   新規に追加されたスキルを skills.lock.json の external セクションに登録する。
#   GitHub API で SKILL.md の name フィールドを照合し、正しい skillPath を解決する。
#   デフォルトで git commit まで実行する（--no-commit でスキップ可能）。
#
# 使い方:
#   bash scripts/skills-add [--catalog-dir PATH] <url-or-owner/repo> [--skill <name>] [--as <alias>] [--prefix] [--no-commit]

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENGINE_ROOT="$(git -C "$DIR" rev-parse --show-toplevel)"
CATALOG_ROOT="${MY_SKILLS_CATALOG_DIR:-}"
# shellcheck source=run-skills-cli.sh
source "$DIR/run-skills-cli.sh"

VALID_NAME_RE='^[a-z0-9]+(--?[a-z0-9]+)*$'

# --- Argument parsing ---
URL=""
NO_COMMIT=false
SKILL_FILTERS=()
ALIAS=""
FORCE_PREFIX=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --catalog-dir)
            [ "$#" -ge 2 ] || { echo "Error: --catalog-dir requires a path" >&2; exit 2; }
            CATALOG_ROOT="$2"
            shift 2
            ;;
        --catalog-dir=*) CATALOG_ROOT="${1#*=}"; shift ;;
        --no-commit) NO_COMMIT=true; shift ;;
        --skill) SKILL_FILTERS+=("$2"); shift 2 ;;
        --as)
            [ "$#" -ge 2 ] || { echo "Error: --as requires a name" >&2; exit 2; }
            ALIAS="$2"
            shift 2
            ;;
        --prefix) FORCE_PREFIX=true; shift ;;
        *) URL="$1"; shift ;;
    esac
done

if [ -n "$ALIAS" ] && [ "${#SKILL_FILTERS[@]}" -ne 1 ]; then
    echo "Error: --as can only be used with a single --skill argument" >&2
    exit 2
fi

: "${URL:?Usage: skills-add [--catalog-dir PATH] <url-or-owner/repo> [--skill <name>] [--as <alias>] [--prefix] [--no-commit]}"
if [ -z "$CATALOG_ROOT" ]; then
    CATALOG_ROOT="$(git rev-parse --show-toplevel)"
fi
[ -d "$CATALOG_ROOT" ] || { echo "Error: Catalog directory not found: $CATALOG_ROOT" >&2; exit 1; }
CATALOG_ROOT="$(cd "$CATALOG_ROOT" && pwd -P)"
LOCK_FILE="$CATALOG_ROOT/skills.lock.json"
IGNORE_FILE="$CATALOG_ROOT/.skills-ignore.json"
ACTIVE_DIR="${MY_SKILLS_ACTIVE_DIR:-$HOME/.agents/skills}"
CLAUDE_DIR="${MY_SKILLS_CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"
GEMINI_DIR="${MY_SKILLS_GEMINI_SKILLS_DIR:-$HOME/.gemini/config/skills}"
VENDOR_FORK="$ENGINE_ROOT/.agents/skills/vendor-fork/scripts/skills-vendor-fork"

# --- Normalize URL to owner/repo ---
OWNER_REPO=$(bun "$DIR/normalize-github-url.ts" "$URL")
SOURCE_URL="https://github.com/${OWNER_REPO}.git"
OWNER="${OWNER_REPO%%/*}"

echo "=== Installing ${OWNER_REPO} ==="

validate_deploy_name() {
    local name="$1"
    [[ "$name" =~ $VALID_NAME_RE ]]
}

lock_lookup() {
    bun "$DIR/lock-check.ts" lookup "$1" "$LOCK_FILE"
}

unlink_agent_skill_dirs() {
    local skill_name="$1"
    [ -n "$skill_name" ] || return 0
    for agent_dir in "$CLAUDE_DIR" "$GEMINI_DIR"; do
        if [ -L "$agent_dir/$skill_name" ]; then
            rm -f "$agent_dir/$skill_name"
        fi
    done
}

link_agent_skill_dirs() {
    local skill_name="$1"
    [ -n "$skill_name" ] || return 0
    [ -d "$ACTIVE_DIR/$skill_name" ] || return 0
    "$ENGINE_ROOT/skill-loom" --catalog-dir "$CATALOG_ROOT" link-agents "$skill_name"
}

place_aliased_skill() {
    local skill_name="$1"
    local target_name="$2"
    local src_dir="$ACTIVE_DIR/$skill_name"
    local target_dir="$ACTIVE_DIR/$target_name"
    [ -d "$src_dir" ] || return 0
    unlink_agent_skill_dirs "$skill_name"
    if [ -e "$target_dir" ]; then
        rm -rf "$target_dir"
    fi
    mv "$src_dir" "$target_dir"
    if [ -f "$target_dir/SKILL.md" ]; then
        bun "$DIR/sync-skill-name.ts" "$target_dir/SKILL.md" "$target_name"
    fi
    link_agent_skill_dirs "$target_name"
}

restore_stashed_upstream() {
    local skill_name="$1"
    local src_dir="$2"
    local stash="$3"
    if [ -n "$stash" ] && [ -d "$stash/$skill_name" ]; then
        if [ -e "$src_dir" ]; then
            rm -rf "$src_dir"
        fi
        mv "$stash/$skill_name" "$src_dir"
        link_agent_skill_dirs "$skill_name"
        rm -rf "$stash"
    fi
}

install_aliased() {
    local skill_name="$1"
    local target_name="$2"
    local src_dir="$ACTIVE_DIR/$skill_name"
    local stash=""

    if [ -d "$src_dir" ] || [ -L "$src_dir" ]; then
        stash=$(mktemp -d "${TMPDIR:-/tmp}/skill-loom-stash.XXXXXX")
        unlink_agent_skill_dirs "$skill_name"
        mv "$src_dir" "$stash/$skill_name"
    fi

    set +e
    skills_cli add "$OWNER_REPO" --skill "$skill_name" -g -a claude-code -a codex -a antigravity -y
    local ec=$?
    set -e
    if [ "$ec" -ne 0 ]; then
        restore_stashed_upstream "$skill_name" "$src_dir" "$stash"
        return "$ec"
    fi
    set +e
    place_aliased_skill "$skill_name" "$target_name"
    local place_ec=$?
    set -e
    restore_stashed_upstream "$skill_name" "$src_dir" "$stash"
    return "$place_ec"
}

prompt_collision() {
    local skill_name="$1"
    local namespaced_name="$2"
    echo "  ⚠️ Conflict: '$skill_name' already exists in skills.lock.json."
    echo "    1) Namespace as '$namespaced_name' (default)"
    echo "    2) Enter custom alias"
    echo "    3) Fork as Vendor Skill"
    echo "    4) Skip"
    read -r -p "    Select option [1-4] (default: 1): " choice </dev/tty || choice="1"
    case "$choice" in
        2)
            while true; do
                read -r -p "    Enter alias: " custom_alias </dev/tty || custom_alias=""
                if [ -z "$custom_alias" ]; then
                    echo "  → Empty alias, skipping"
                    return 1
                fi
                if ! validate_deploy_name "$custom_alias"; then
                    echo "  → Invalid alias '$custom_alias' (use kebab-case, no slashes)"
                    continue
                fi
                if [ "$(lock_lookup "$custom_alias")" != "none" ]; then
                    echo "  → Alias '$custom_alias' already in skills.lock.json"
                    continue
                fi
                TARGET_NAME="$custom_alias"
                return 0
            done
            ;;
        3)
            echo "  → Forking '$skill_name' as Vendor Skill"
            if ! bash "$VENDOR_FORK" --catalog-dir "$CATALOG_ROOT" "$skill_name"; then
                echo "  → Vendor fork failed, skipping"
                return 1
            fi
            bun "$DIR/register-skill-lock.ts" --vendor "$LOCK_FILE" "$skill_name" "$OWNER_REPO"
            echo "  → Registered vendor/$skill_name (skipped external import)"
            return 1
            ;;
        4)
            echo "  → Skipping by user choice"
            return 1
            ;;
        *)
            TARGET_NAME="$namespaced_name"
            return 0
            ;;
    esac
}

plan_skill() {
    local skill_name="$1"
    TARGET_NAME="$skill_name"
    INSTALL_SKILL=""

    local in_ignore
    in_ignore=$(bun "$DIR/lock-check.ts" ignore "$skill_name" "$IGNORE_FILE")
    if [ "$in_ignore" = "yes" ]; then
        echo "  → Skipping (in .skills-ignore.json)"
        return 1
    fi

    local lookup namespaced_name
    lookup=$(lock_lookup "$skill_name")
    namespaced_name="${OWNER}--${skill_name}"

    if [ -n "$ALIAS" ]; then
        if ! validate_deploy_name "$ALIAS"; then
            echo "Error: --as '$ALIAS' is not a valid skill name (kebab-case, no slashes)" >&2
            exit 2
        fi
        if [ "$(lock_lookup "$ALIAS")" != "none" ]; then
            echo "  → Alias '$ALIAS' already in skills.lock.json, skipping"
            return 1
        fi
        TARGET_NAME="$ALIAS"
        INSTALL_SKILL="$skill_name"
        return 0
    fi

    if [ "$FORCE_PREFIX" = true ]; then
        if [ "$(lock_lookup "$namespaced_name")" != "none" ]; then
            echo "  → '$namespaced_name' already in skills.lock.json, skipping"
            return 1
        fi
        TARGET_NAME="$namespaced_name"
        INSTALL_SKILL="$skill_name"
        return 0
    fi

    if [ "$lookup" = "external $OWNER_REPO" ]; then
        echo "  → Skipping (already registered from $OWNER_REPO)"
        return 1
    fi

    if [ "$lookup" != "none" ]; then
        if [ "$(lock_lookup "$namespaced_name")" != "none" ]; then
            echo "  → Both '$skill_name' and '$namespaced_name' already in skills.lock.json, skipping"
            return 1
        fi
        if [ -t 0 ] && [ -r /dev/tty ]; then
            if ! prompt_collision "$skill_name" "$namespaced_name"; then
                return 1
            fi
        else
            echo "  → Notice: '$skill_name' already in skills.lock.json; namespacing as '$namespaced_name'"
            TARGET_NAME="$namespaced_name"
        fi
        INSTALL_SKILL="$skill_name"
        return 0
    fi

    TARGET_NAME="$skill_name"
    INSTALL_SKILL=""
    return 0
}

# --- Temp files ---
BEFORE_FILE=$(mktemp)
AFTER_FILE=$(mktemp)
TREE_FILE=$(mktemp)
trap 'rm -f "$BEFORE_FILE" "$AFTER_FILE" "$TREE_FILE"' EXIT

mkdir -p "$ACTIVE_DIR"
(ls -1 "$ACTIVE_DIR/" 2>/dev/null || true) | (grep -v '^\.' || true) | sort > "$BEFORE_FILE"

# --- Fetch repo tree once (skillPath + unfiltered name discovery) ---
echo "  Fetching repo tree from GitHub..."
HAS_TREE=false
if gh api "repos/${OWNER_REPO}/git/trees/HEAD?recursive=1" > "$TREE_FILE" 2>/dev/null; then
    HAS_TREE=true
else
    echo "  Warning: Could not fetch repo tree. Will use pattern matching for skillPath."
fi

PLANNED_UPSTREAM=()
PLANNED_DEPLOY=()
PLANNED_INSTALL_SKILL=()

plan_and_record() {
    local skill_name="$1"
    echo ""
    echo "  Processing: $skill_name"
    if plan_skill "$skill_name"; then
        PLANNED_UPSTREAM+=("$skill_name")
        PLANNED_DEPLOY+=("$TARGET_NAME")
        PLANNED_INSTALL_SKILL+=("$INSTALL_SKILL")
    fi
}

if [ "${#SKILL_FILTERS[@]}" -gt 0 ]; then
    for skill in "${SKILL_FILTERS[@]}"; do
        plan_and_record "$skill"
    done
else
    skills_cli add "$OWNER_REPO" -g -a claude-code -a codex -a antigravity -y
    (ls -1 "$ACTIVE_DIR/" 2>/dev/null || true) | (grep -v '^\.' || true) | sort > "$AFTER_FILE"
    NEW_SKILLS=$(comm -13 "$BEFORE_FILE" "$AFTER_FILE" || true)
    while IFS= read -r skill_name; do
        [ -n "$skill_name" ] || continue
        plan_and_record "$skill_name"
    done <<< "$NEW_SKILLS"
fi

if [ "${#PLANNED_UPSTREAM[@]}" -eq 0 ]; then
    echo "No new skills registered."
    exit 0
fi

if [ "${#SKILL_FILTERS[@]}" -gt 0 ]; then
    STANDARD_SKILLS=()
    i=0
    while [ "$i" -lt "${#PLANNED_UPSTREAM[@]}" ]; do
        upstream="${PLANNED_UPSTREAM[$i]}"
        deploy="${PLANNED_DEPLOY[$i]}"
        if [ "$deploy" = "$upstream" ]; then
            STANDARD_SKILLS+=("$upstream")
        else
            install_aliased "$upstream" "$deploy"
        fi
        i=$((i + 1))
    done
    if [ "${#STANDARD_SKILLS[@]}" -gt 0 ]; then
        SKILL_ARGS=()
        for skill in "${STANDARD_SKILLS[@]}"; do
            SKILL_ARGS+=(--skill "$skill")
        done
        skills_cli add "$OWNER_REPO" "${SKILL_ARGS[@]}" -g -a claude-code -a codex -a antigravity -y
        for skill in "${STANDARD_SKILLS[@]}"; do
            link_agent_skill_dirs "$skill"
        done
    fi
else
    i=0
    while [ "$i" -lt "${#PLANNED_UPSTREAM[@]}" ]; do
        upstream="${PLANNED_UPSTREAM[$i]}"
        deploy="${PLANNED_DEPLOY[$i]}"
        if [ "$deploy" != "$upstream" ] && [ -d "$ACTIVE_DIR/$upstream" ]; then
            place_aliased_skill "$upstream" "$deploy"
        else
            link_agent_skill_dirs "$deploy"
        fi
        i=$((i + 1))
    done
fi

(ls -1 "$ACTIVE_DIR/" 2>/dev/null || true) | (grep -v '^\.' || true) | sort > "$AFTER_FILE"

echo ""
echo "=== Registering in skills.lock.json ==="

REGISTERED_NAMES=()
i=0
while [ "$i" -lt "${#PLANNED_UPSTREAM[@]}" ]; do
    skill_name="${PLANNED_UPSTREAM[$i]}"
    TARGET_NAME="${PLANNED_DEPLOY[$i]}"
    INSTALL_SKILL="${PLANNED_INSTALL_SKILL[$i]}"

    SKILL_PATH=""
    if [ "$HAS_TREE" = "true" ]; then
        SKILL_PATH=$(SKILL_NAME="$skill_name" OWNER_REPO="$OWNER_REPO" TREE_FILE="$TREE_FILE" \
            bun "$DIR/resolve-skill-path.ts" 2>/dev/null) || true
    fi
    if [ -z "$SKILL_PATH" ]; then
        if [ "$HAS_TREE" = "true" ]; then
            echo "  Warning: skillPath not resolved via API, using pattern matching"
        fi
        SKILL_PATH="skills/${skill_name}/SKILL.md"
    fi

    echo "  → skillPath: $SKILL_PATH"
    if [ -n "$INSTALL_SKILL" ]; then
        bun "$DIR/register-skill-lock.ts" "$LOCK_FILE" "$TARGET_NAME" "$OWNER_REPO" "$SOURCE_URL" "$SKILL_PATH" "$INSTALL_SKILL"
    else
        bun "$DIR/register-skill-lock.ts" "$LOCK_FILE" "$TARGET_NAME" "$OWNER_REPO" "$SOURCE_URL" "$SKILL_PATH"
    fi
    REGISTERED_NAMES+=("$TARGET_NAME")
    i=$((i + 1))
done

if [ "${#REGISTERED_NAMES[@]}" -eq 0 ]; then
    echo ""
    echo "No new skills registered."
    exit 0
fi

NAMES_STR=$(printf "%s, " "${REGISTERED_NAMES[@]}")
NAMES_STR="${NAMES_STR%, }"

if [ "$NO_COMMIT" = false ]; then
    git -C "$CATALOG_ROOT" add skills.lock.json
    git -C "$CATALOG_ROOT" commit -m "chore: add ${NAMES_STR} to skills.lock.json"
    echo ""
    echo "=== Done: committed ${NAMES_STR} ==="
else
    echo ""
    echo "=== Done: registered ${NAMES_STR} (--no-commit, commit skipped) ==="
fi
