#!/bin/bash
set -euo pipefail

scan_output=$(mktemp)
error_output=$(mktemp)
cleanup() {
  "${MY_SKILLS_TRASH_BIN:-/usr/bin/trash}" "$scan_output" "$error_output" 2>/dev/null || true
}
trap cleanup EXIT

set +e
bunx secretlint --format json --secretlintrc .secretlintrc.json "$@" > "$scan_output" 2> "$error_output"
status=$?
set -e

if [ "$status" -ne 0 ]; then
  if [ -s "$scan_output" ]; then
    bun -e '
      const reports = await Bun.file(process.argv[1]).json()
      for (const report of reports) {
        for (const message of report.messages ?? []) {
          const line = message.loc?.start?.line ?? "?"
          const column = message.loc?.start?.column ?? "?"
          console.error(`${report.source}:${line}:${column} ${message.ruleId}`)
        }
      }
    ' "$scan_output"
  else
    echo "secretlint failed before producing a location report" >&2
  fi
fi

exit "$status"
