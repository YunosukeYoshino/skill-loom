#!/bin/bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if [ ! -f LICENSE ]; then
  echo "Missing required publication file: LICENSE" >&2
  exit 1
fi

violations=$(git ls-files | rg -n -f scripts/publication-denylist.txt || true)
if [ -n "$violations" ]; then
  echo "Publication denylist violations:" >&2
  echo "$violations" >&2
  exit 1
fi

git ls-files -z | xargs -0 bash scripts/secret-scan

# Reject reintroduced Engine Python deps (issue #1: Bun/TypeScript sole runtime).
# New .py files or executable references to the old runtime break Bun-only install/test.
py_files=$(git ls-files -- '*.py')
if [ -n "$py_files" ]; then
  echo "Engine-owned Python files reintroduced:" >&2
  echo "$py_files" >&2
  exit 1
fi

# ripgrep: -e is the pattern flag (-E is encoding). Exit 0=match, 1=none, >=2=error.
# Drop this script from the input set so the pattern literal does not self-match
# (path args ignore --glob excludes).
set +e
py_refs=$(
  git ls-files -z     | grep -vzE '^(scripts/publication-check)$'     | xargs -0 rg -l -e '(^|[^a-zA-Z])(python3|python |uv run|uv sync|uv lock|uvx|pip install|exec python)'
)
rg_status=$?
set -e
if [ "$rg_status" -ge 2 ]; then
  echo "publication-check: failed to scan for Python/uv references (rg exit $rg_status)" >&2
  exit 1
fi
if [ "$rg_status" -eq 0 ] && [ -n "$py_refs" ]; then
  echo "Python/uv executable references reintroduced:" >&2
  echo "$py_refs" >&2
  exit 1
fi

echo "Publication checks passed"
